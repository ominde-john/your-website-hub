# Supabase Configuration
# Get these values from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# reCAPTCHA Configuration (optional - form will work without it)
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Web3Forms Configuration - REQUIRED for contact form
# Contact form submissions will be sent to the email registered with Web3Forms
# For production: Set this in your Vercel environment variables
VITE_WEB3FORMS_ACCESS_KEY=cfeb2c00-e884-4f54-8496-315cf9f85c42
