# Supabase Configuration
# Get these values from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api

# Your Supabase project reference ID (found in project settings or URL)
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Your Supabase anon/public key (found in API settings)
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Your Supabase project URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# reCAPTCHA Configuration (optional - form will work without it)
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Web3Forms Configuration - REQUIRED for contact form
# Contact form submissions will be sent to the email registered with Web3Forms (ominde@jonzjohn.com)
# Get your access key from https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Stripe Configuration - REQUIRED for payment processing
# Get your secret key from https://dashboard.stripe.com/apikeys
# Note: Use test keys for development (sk_test_...) and live keys for production (sk_live_...)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
